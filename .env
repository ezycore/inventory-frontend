NEXT_PUBLIC_API_URL=http://localhost:5800/api

# Empty in local dev → workspaceUrl() returns relative paths (no subdomain hop).
NEXT_PUBLIC_ROOT_DOMAIN=

# Tenant root domain (e.g. "ezycore.com"). Empty in local dev → *.localhost
# subdomains stand in for tenant subdomains (e.g. http://rmc41.localhost:3000/shop).
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=ezycore.com

# Custom domains mapped to a store slug as JSON, e.g. {"mystore.com":"rmc41"}.
# Wired manually per merchant. Empty in dev.
NEXT_PUBLIC_CUSTOM_DOMAIN_MAP=
