# Every var here is NEXT_PUBLIC_* and therefore BAKED IN AT BUILD TIME. In deploys
# they are passed as `build-args` (.github/workflows/deploy.yml → Dockerfile ARG/ENV),
# which is why easystock-infra/templates/frontend.env.example carries only NODE_ENV
# at runtime and lists these as build-time-only. Changing one requires a REBUILD +
# redeploy, not an env edit on the server.
#
# KEEP IN SYNC with easystock-infra/templates/frontend.env.example (and the
# build-args in deploy.yml + the ARGs in Dockerfile — all four move together).
# See CLAUDE.md → "Infra env templates (mandatory)".

# Backend API base, including /api.
#   local dev  →  http://localhost:5800/api
#   staging    →  https://rc-api.ezycore.com/api
#   production →  https://api.ezycore.com/api
NEXT_PUBLIC_API_URL=http://localhost:5800/api

# Apex domain that workspaces live under. Used to build per-workspace subdomain
# URLs, e.g. acme.ezycore.com (see lib/organization-utils.ts → workspaceUrl).
# Leave empty for local/single-host dev. NEXT_PUBLIC_* is baked at BUILD time —
# set this when building the production frontend image (DEPLOYMENT.md §10.1).
NEXT_PUBLIC_ROOT_DOMAIN=ezycore.com

# Tenant root domain for the storefront (must match NEXT_PUBLIC_ROOT_DOMAIN).
# Subdomains like rmc.ezycore.com are parsed as store slugs against this value.
# NEXT_PUBLIC_* is baked at BUILD time — set this when building the production image.
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=ezycore.com

# Manual override: custom domains mapped to a store slug as JSON, e.g.
# {"mystore.com":"rmc41"}. Normally unneeded — self-serve domains (Settings →
# Domains) resolve dynamically via /api/public/store-by-host in proxy.ts.
NEXT_PUBLIC_CUSTOM_DOMAIN_MAP=