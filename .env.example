NEXT_PUBLIC_API_URL=https://easystock-backend-kdjf.onrender.com/api

# Auth provider — must match the backend's AUTH_PROVIDER env.
# - "legacy" (default if unset): EasyStock-owned bcrypt + JWT; the
#   `organizationSlug` field is rendered on login/forgot/resend forms.
# - "yocore": YoCore-owned identity; the slug field is hidden because
#   workspace selection happens AFTER login via the workspace picker.
# Flip together with the backend on Phase 3.5 cutover (see
# Yocore/docs/runbooks/auth-cutover.md). Build-time only — requires a redeploy.
NEXT_PUBLIC_AUTH_PROVIDER=legacy