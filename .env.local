NEXT_PUBLIC_API_URL=http://localhost:5800/api

# Empty in local dev → workspaceUrl() returns relative paths (no subdomain hop).
NEXT_PUBLIC_ROOT_DOMAIN=

NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=localhost:3000

# Local only. Lets the CUSTOM-DOMAIN shape be exercised without a real domain:
# the map is consulted BEFORE the `*.localhost` branch, so this host resolves
# with `base: ""` and serves the shop at the ROOT — `/pages/about`, not
# `/shop/pages/about`. It points at the same QA clone as `uriibaba-qa.localhost`,
# which keeps the tenant-subdomain shape, so the two can be compared side by
# side. Chrome resolves any `*.localhost` to 127.0.0.1, so no DNS or hosts file
# is needed. It also carries no admin cookie, so it renders the true PUBLIC view
# rather than the owner preview.
NEXT_PUBLIC_CUSTOM_DOMAIN_MAP={"uriibaba-shop.localhost":"uriibaba-qa"}
