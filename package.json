{
  "name": "frontend",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-help-content.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-help-content.mjs",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=-1",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen:api-types": "openapi-typescript ../inventory-backend/docs/reference/openapi.json -o types/api-generated.ts",
    "verify:api-types": "node scripts/verify-api-types.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "help:build": "node scripts/build-help-content.mjs",
    "help:verify": "node scripts/verify-help-docs.mjs",
    "gen:section-manifest": "node scripts/gen-section-manifest.mjs",
    "verify:section-manifest": "node scripts/gen-section-manifest.mjs --check",
    "verify": "pnpm verify:api-types && pnpm verify:section-manifest && pnpm docs:verify && pnpm help:verify && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pixel:capture": "playwright test -c tests/pixel/pixel.config.ts --update-snapshots=all",
    "pixel:compare": "playwright test -c tests/pixel/pixel.config.ts",
    "gen:persona-appendix": "node scripts/gen-persona-appendix.mjs > ../inventory-backend/docs/features/merchant-persona-appendix.md"
  },
